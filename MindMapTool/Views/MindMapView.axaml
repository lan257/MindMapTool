<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MindMapTool.ViewModels"
    xmlns:views="using:MindMapTool.Views"
    x:DataType="vm:MindMapViewModel"
    x:Class="MindMapTool.Views.MindMapView">

	<StackPanel Spacing="10" Padding="10">
		<StackPanel Orientation="Horizontal" Spacing="8">
			<TextBlock Text="MindMap ID:" VerticalAlignment="Center"/>
			<TextBox Width="80" Text="{Binding ID}"/>
			<Button Content="加载" Command="{Binding RenderCommand}"/>
		</StackPanel>

		<ItemsControl Items="{Binding Nodes}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<Canvas/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:NodeViewModel">
					<views:NodeView/>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</StackPanel>

</UserControl>
