<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
			  xmlns:model="using:MindMapTool.Models"
			 xmlns:vm="using:MindMapTool.ViewModels"
			 xmlns:views="using:MindMapTool.Views"
			 x:DataType="vm:SideBarViewModel"
             x:Class="MindMapTool.Views.SideBarView">
	<UserControl.DataContext>
		<vm:SideBarViewModel/>
	</UserControl.DataContext>
	
	<!--左侧功能边栏-->
	<Border Background="#2F3136" Width="200">
		<StackPanel Spacing="12">

			<TextBlock Text="功能菜单"
                       FontSize="18"
                       Foreground="White"
                       Margin="0 0 0 10"/>

			<Button Content="数据接口管理"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DataEditCommand}"/>

			<Separator/>

			<Button Content="设置"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SettingsCommand}"/>

		</StackPanel>
	</Border>
</UserControl>
